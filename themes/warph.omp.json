{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#1e1e20",
          "foreground": "#f9f7f9",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b0",
          "options": {
            "style": "full"
          },
          "style": "diamond",
          "template": " {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#343636",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#c8c6c9{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ababae{{ end }}",
            "{{ if gt .Ahead 0 }}#9b9a9c{{ end }}",
            "{{ if gt .Behind 0 }}#9b9a9c{{ end }}"
          ],
          "foreground": "#f9f7f9",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#0c0d0d{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#0c0d0d{{ end }}",
            "{{ if gt .Ahead 0 }}#0c0d0d{{ end }}",
            "{{ if gt .Behind 0 }}#0c0d0d{{ end }}"
          ],
          "trailing_diamond": "\ue0b4",
          "options": {
            "fetch_status": true
          },
          "style": "diamond",
          "template": " {{ .HEAD }}{{ if .Staging.Changed }}<#49494b> \uf046 {{ .Staging.String }}</>{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
